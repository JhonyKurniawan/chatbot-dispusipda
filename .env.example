# Konfigurasi Environment Chatbot Dispusipda
# Salin file ini menjadi .env dan sesuaikan nilainya

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=chatbot_dispusipda

# ==================== LLM API KEYS ====================
# Pilih salah satu: groq atau gemini
LLM_PROVIDER=groq

# Groq API Key (dapatkan di https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (dapatkan di https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyAdnlirGnokkon__r8-AglnJCXNJLmG9Lc

# ==================== FLASK API ====================
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=False
CORS_ORIGINS=*

# ==================== AUTO UPDATE ====================
AUTO_UPDATE_ENABLED=False
AUTO_UPDATE_INTERVAL=24
